# Configuración pública del proyecto Appwrite de UP Training Center.
# Nunca agregues aquí una API key de servidor.
VITE_APPWRITE_PROJECT_ID=6a6bd26500326fd9d3ac
VITE_APPWRITE_PROJECT_NAME=UP-TC
VITE_APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1

# URL HTTPS pública registrada como plataforma Web en Appwrite.
# En desarrollo se usa automáticamente http://localhost:3000.
VITE_APPWRITE_PUBLIC_URL=https://tu-dominio-publico.example

# ID de la función incluida en appwrite/functions/delete-account.
VITE_APPWRITE_DELETE_ACCOUNT_FUNCTION_ID=delete-account
